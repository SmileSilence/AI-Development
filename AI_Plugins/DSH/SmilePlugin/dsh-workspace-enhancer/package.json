{
  "name": "smilexx-workspace-enhancer",
  "version": "0.7.5",
  "description": "DSH 右侧工作区增强：工作区/会话置顶、悬停 Codex 式信息卡（目录点击打开）、右键菜单、空白区右键、批量归档/删除、会话默认模式选择器、标签筛选（飞书式 7 种操作符，多条件 AND）、一键折叠/展开全部（图标随状态）。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "web-ui",
    "workspace",
    "sidebar"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run check:version && npm pack --dry-run",
    "check:version": "node scripts/check-version.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-native-command": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.12",
    "react": "^18.2.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
