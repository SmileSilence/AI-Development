{
  "name": "smilexx-skill-mcp-manager",
  "version": "0.4.1",
  "description": "DSH 技能与 MCP 管理面板：技能管理（按类型分类、启停/删除/添加/迁移/分组）+ MCP 管理（cordis.patch.yml 受管块，Stdio/HTTP，HMR 热加载）。基于 dsh-skill-mcp-panel v2.0.2 重构。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.4",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-alpha.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^5.0.0"
  },
  "bin": {
    "dsh-panel": "./lib/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs",
    "prepack": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs"
  },
  "files": [
    "lib",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
