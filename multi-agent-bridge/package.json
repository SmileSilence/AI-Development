{
  "name": "multi-agent-bridge",
  "version": "1.4.0",
  "description": "支持 Codex、Claude 与 DSH 互相委派的本地多 Agent MCP 服务。",
  "type": "module",
  "bin": {
    "multi-agent-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs && python -m unittest discover -s test -p test_*.py",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
